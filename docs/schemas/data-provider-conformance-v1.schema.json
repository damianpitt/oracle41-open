{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/damianpitt/oracle41-open/blob/main/docs/schemas/data-provider-conformance-v1.schema.json",
  "title": "Oracle41 Data Provider Conformance Fixture v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "provider_id",
    "operations",
    "expected"
  ],
  "properties": {
    "format": {
      "const": "oracle41-data-provider-conformance"
    },
    "version": {
      "const": 1
    },
    "provider_id": {
      "enum": [
        "alchemy",
        "ankr",
        "moralis",
        "goldrush"
      ]
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_balance",
        "token_balances",
        "activity",
        "token_history"
      ],
      "properties": {
        "native_balance": {
          "$ref": "#/$defs/operation"
        },
        "token_balances": {
          "$ref": "#/$defs/operation"
        },
        "activity": {
          "$ref": "#/$defs/operation"
        },
        "token_history": {
          "$ref": "#/$defs/operation"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_balance",
        "token_balance_symbol",
        "token_balance",
        "activity_hash",
        "activity_value",
        "token_history_categories"
      ],
      "properties": {
        "native_balance": {
          "type": "string"
        },
        "token_balance_symbol": {
          "type": "string"
        },
        "token_balance": {
          "type": "string"
        },
        "activity_hash": {
          "type": "string"
        },
        "activity_value": {
          "type": "string"
        },
        "token_history_categories": {
          "type": "array",
          "items": {
            "enum": [
              "erc20",
              "erc721",
              "erc1155"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responses"
      ],
      "properties": {
        "responses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "result"
            ],
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1
              },
              "result": {}
            }
          }
        }
      }
    }
  }
}
